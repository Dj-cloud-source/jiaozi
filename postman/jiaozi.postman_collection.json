{
  "info": {
    "_postman_id": "0a5483e0-bb22-4d42-8fd6-a424331d7130",
    "name": "Jiaozi API - Phase 1",
    "description": "第一阶段联调：健康检查、注册、登录和获取当前用户。请按文件夹内的编号顺序执行请求。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 基础链路",
      "description": "依次执行四个请求。登录成功后会自动保存 user_token。",
      "item": [
        {
          "name": "01 健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "确认 Postman 可以访问 Linux 中运行的 Go 后端。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"服务状态正常\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.service).to.eql(\"jiaozi\");",
                  "    pm.expect(body.data.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{user_phone}}\",\n  \"password\": \"{{user_password}}\",\n  \"nickname\": \"{{user_nickname}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "首次执行前确认 user_phone 尚未注册。重复测试时请在 Environment 中更换手机号。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"注册成功并返回用户信息\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.user_id).to.be.a(\"number\");",
                  "    pm.expect(body.data.phone).to.eql(pm.environment.get(\"user_phone\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{user_phone}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "登录成功后，Tests 脚本会把 access_token 保存为 user_token。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var body = pm.response.json();",
                  "pm.test(\"登录成功并返回 Token\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.access_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 200 && body.code === 0 && body.data.access_token) {",
                  "    pm.environment.set(\"user_token\", body.data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 获取当前用户",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{user_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "使用登录请求自动保存的 user_token 查询当前用户。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"返回当前登录用户\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.phone).to.eql(pm.environment.get(\"user_phone\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 基础异常场景",
      "description": "先完成基础链路，再手动执行这些请求。",
      "item": [
        {
          "name": "01 重复手机号注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{user_phone}}\",\n  \"password\": \"{{user_password}}\",\n  \"nickname\": \"{{user_nickname}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"重复注册返回 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(41001);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 错误密码登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{user_phone}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"错误密码返回 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(41002);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 未登录获取当前用户",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "此请求故意不携带 Authorization Header。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"未登录返回 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(41003);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
