{
  "info": {
    "_postman_id": "0a5483e0-bb22-4d42-8fd6-a424331d7130",
    "name": "Jiaozi API - Phase 1-3",
    "description": "第一至三阶段联调：用户基础链路、管理员登录、站点准备和车次开售。请按文件夹内的编号顺序执行请求。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 基础链路",
      "description": "依次执行四个请求。登录成功后会自动保存 user_token。",
      "item": [
        {
          "name": "01 健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "确认 Postman 可以访问 Linux 中运行的 Go 后端。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"服务状态正常\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.service).to.eql(\"jiaozi\");",
                  "    pm.expect(body.data.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"13800138000\",\n  \"password\": \"123456\",\n  \"nickname\": \"zhangsan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "直接在 Body 中填写注册信息。重复测试时请换一个尚未注册的手机号。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var submitted = JSON.parse(pm.request.body.raw);",
                  "var body = pm.response.json();",
                  "pm.test(\"注册成功并返回用户信息\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.user_id).to.be.a(\"number\");",
                  "    pm.expect(body.data.phone).to.eql(submitted.phone);",
                  "});",
                  "",
                  "if (pm.response.code === 201 && body.code === 0) {",
                  "    pm.environment.set(\"user_phone\", submitted.phone);",
                  "    pm.environment.set(\"user_nickname\", submitted.nickname);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"13800138000\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "登录成功后，Tests 脚本会把 access_token 保存为 user_token。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var submitted = JSON.parse(pm.request.body.raw);",
                  "var body = pm.response.json();",
                  "pm.test(\"登录成功并返回 Token\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.access_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "if (pm.response.code === 200 && body.code === 0 && body.data.access_token) {",
                  "    pm.environment.set(\"user_phone\", submitted.phone);",
                  "    pm.environment.set(\"user_token\", body.data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 获取当前用户",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{user_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "使用登录请求自动保存的 user_token 查询当前用户。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"返回当前登录用户\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.phone).to.eql(pm.environment.get(\"user_phone\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 基础异常场景",
      "description": "先完成基础链路，再手动执行这些请求。",
      "item": [
        {
          "name": "01 重复手机号注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{user_phone}}\",\n  \"password\": \"123456\",\n  \"nickname\": \"duplicate-test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"重复注册返回 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(41001);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 错误密码登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{user_phone}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"错误密码返回 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(41002);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 未登录获取当前用户",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "此请求故意不携带 Authorization Header。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"未登录返回 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(41003);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 管理员与站点",
      "description": "执行前先在 Linux 中初始化管理员。依次执行后会保存 admin_token、departure_station_id 和 arrival_station_id。",
      "item": [
        {
          "name": "01 管理员登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "auth",
                "login"
              ]
            },
            "description": "管理员账号需要先通过 cmd/admin-init 在 Linux 中创建。登录成功后自动保存 admin_token。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var submitted = JSON.parse(pm.request.body.raw);",
                  "var body = pm.response.json();",
                  "pm.test(\"管理员登录成功并返回 Token\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.access_token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(body.data.admin.username).to.eql(submitted.username);",
                  "});",
                  "",
                  "if (pm.response.code === 200 && body.code === 0 && body.data.access_token) {",
                  "    pm.environment.set(\"admin_token\", body.data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 创建出发站",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"南京南\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations"
              ]
            },
            "description": "创建下一阶段车次使用的出发站，并自动保存 departure_station_id。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var submitted = JSON.parse(pm.request.body.raw);",
                  "var body = pm.response.json();",
                  "pm.test(\"出发站创建成功\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.id).to.be.a(\"number\");",
                  "    pm.expect(body.data.name).to.eql(submitted.name);",
                  "    pm.expect(body.data.status).to.eql(\"ACTIVE\");",
                  "});",
                  "",
                  "if (pm.response.code === 201 && body.code === 0 && body.data.id) {",
                  "    pm.environment.set(\"departure_station_name\", submitted.name);",
                  "    pm.environment.set(\"departure_station_id\", body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 创建到达站",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"上海虹桥\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations"
              ]
            },
            "description": "创建下一阶段车次使用的到达站，并自动保存 arrival_station_id。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var submitted = JSON.parse(pm.request.body.raw);",
                  "var body = pm.response.json();",
                  "pm.test(\"到达站创建成功\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.id).to.be.a(\"number\");",
                  "    pm.expect(body.data.name).to.eql(submitted.name);",
                  "    pm.expect(body.data.status).to.eql(\"ACTIVE\");",
                  "});",
                  "",
                  "if (pm.response.code === 201 && body.code === 0 && body.data.id) {",
                  "    pm.environment.set(\"arrival_station_name\", submitted.name);",
                  "    pm.environment.set(\"arrival_station_id\", body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 查询公开站点",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations"
              ]
            },
            "description": "普通用户无需登录即可查询所有 ACTIVE 站点。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"公开列表包含新建站点\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    var ids = body.data.map(function (station) { return station.id; });",
                  "    pm.expect(ids).to.include(Number(pm.environment.get(\"departure_station_id\")));",
                  "    pm.expect(ids).to.include(Number(pm.environment.get(\"arrival_station_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 管理员查询站点",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "stations"
              ]
            },
            "description": "管理员列表包含站点状态字段。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"管理员列表包含两个 ACTIVE 站点\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    var expected = [Number(pm.environment.get(\"departure_station_id\")), Number(pm.environment.get(\"arrival_station_id\"))];",
                  "    var matched = body.data.filter(function (station) { return expected.indexOf(station.id) !== -1 && station.status === \"ACTIVE\"; });",
                  "    pm.expect(matched.length).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 车次创建与开售",
      "description": "重新加载站点 ID，创建明天的车次、发布并等待定时任务开售。执行前需要完成管理员与站点阶段。",
      "item": [
        {
          "name": "01 加载站点 ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations"
              ]
            },
            "description": "根据 Environment 中的两个站点名称查找并保存站点 ID，解决重新导入 Environment 后 ID 为空的问题。"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var body = pm.response.json();",
                  "var departureName = pm.environment.get(\"departure_station_name\");",
                  "var arrivalName = pm.environment.get(\"arrival_station_name\");",
                  "var departure = body.data.find(function (station) { return station.name === departureName; });",
                  "var arrival = body.data.find(function (station) { return station.name === arrivalName; });",
                  "",
                  "pm.test(\"按名称找到两个可用站点\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    pm.expect(departure, \"未找到出发站：\" + departureName).to.exist;",
                  "    pm.expect(arrival, \"未找到到达站：\" + arrivalName).to.exist;",
                  "});",
                  "",
                  "if (departure && arrival) {",
                  "    pm.environment.set(\"departure_station_id\", departure.id);",
                  "    pm.environment.set(\"arrival_station_id\", arrival.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 创建车次",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"train_no\": \"{{train_no}}\",\n  \"departure_date\": \"{{train_date}}\",\n  \"departure_station_id\": {{departure_station_id}},\n  \"arrival_station_id\": {{arrival_station_id}},\n  \"departure_time\": \"{{departure_time}}\",\n  \"arrival_time\": \"{{arrival_time}}\",\n  \"sale_start_time\": \"{{sale_start_time}}\",\n  \"first_class_price\": \"199.00\",\n  \"second_class_price\": \"99.00\",\n  \"first_class_seat_count\": 2,\n  \"second_class_seat_count\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/trains",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "trains"
              ]
            },
            "description": "脚本会生成明天的车次和当前时间前 1 分钟的开售时间。创建成功后自动保存 train_id。"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function twoDigits(value) {",
                  "    return String(value).padStart(2, \"0\");",
                  "}",
                  "",
                  "function shanghaiDateTime(value) {",
                  "    var shifted = new Date(value.getTime() + 8 * 60 * 60 * 1000);",
                  "    return shifted.getUTCFullYear() + \"-\" +",
                  "        twoDigits(shifted.getUTCMonth() + 1) + \"-\" +",
                  "        twoDigits(shifted.getUTCDate()) + \"T\" +",
                  "        twoDigits(shifted.getUTCHours()) + \":\" +",
                  "        twoDigits(shifted.getUTCMinutes()) + \":\" +",
                  "        twoDigits(shifted.getUTCSeconds()) + \"+08:00\";",
                  "}",
                  "",
                  "var now = new Date();",
                  "var shanghaiNow = new Date(now.getTime() + 8 * 60 * 60 * 1000);",
                  "var tomorrow = new Date(Date.UTC(shanghaiNow.getUTCFullYear(), shanghaiNow.getUTCMonth(), shanghaiNow.getUTCDate() + 1));",
                  "var trainDate = tomorrow.getUTCFullYear() + \"-\" + twoDigits(tomorrow.getUTCMonth() + 1) + \"-\" + twoDigits(tomorrow.getUTCDate());",
                  "var trainNo = \"G\" + String(Math.floor(now.getTime() / 1000) % 10000).padStart(4, \"0\");",
                  "",
                  "pm.environment.set(\"train_no\", trainNo);",
                  "pm.environment.set(\"train_date\", trainDate);",
                  "pm.environment.set(\"departure_time\", trainDate + \"T08:30:00+08:00\");",
                  "pm.environment.set(\"arrival_time\", trainDate + \"T10:10:00+08:00\");",
                  "pm.environment.set(\"sale_start_time\", shanghaiDateTime(new Date(now.getTime() - 60 * 1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 状态码为 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var submitted = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "var body = pm.response.json();",
                  "pm.test(\"车次以草稿状态创建\", function () {",
                  "    pm.expect(body.code).to.eql(0);",
                  "    pm.expect(body.data.id).to.be.a(\"number\");",
                  "    pm.expect(body.data.train_no).to.eql(pm.environment.get(\"train_no\"));",
                  "    pm.expect(body.data.status).to.eql(\"DRAFT\");",
                  "});",
                  "",
                  "if (pm.response.code === 201 && body.code === 0 && body.data.id) {",
                  "    pm.environment.set(\"train_id\", body.data.id);",
                  "    pm.environment.set(\"first_class_seat_count\", submitted.first_class_seat_count);",
                  "    pm.environment.set(\"second_class_seat_count\", submitted.second_class_seat_count);",
                  "}"
                ]
              }
            }
          ]
